{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "next-sanity/studio": [
        "./node_modules/next-sanity/dist/studio/index.d.ts"
      ],
    }
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "scripts/runPipeline.js",
    "scripts/uploader/sanity-uploader.js",
    "scripts/scrapers/news-scraper.js",
    "scripts/ai/article-generator.js",
    "tailwind.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
